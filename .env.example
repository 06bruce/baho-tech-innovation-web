# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_TTL_DAYS=7

# Admin seed account (created on server start if the email does not exist)
ADMIN_NAME=Baho Tech Admin
ADMIN_EMAIL=admin@bahotech.com
ADMIN_PASSWORD=admin@2007

# SMTP settings (optional in development; required for real email delivery)
# Registration still succeeds if these are not configured, but welcome/contact emails are skipped.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_FROM=no-reply@bahotech.com
SMTP_TO=contact@bahotech.com

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Frontend (optional)
VITE_API_BASE_URL=http://localhost:3001/api
